# Kirana Mitra: Google Cloud settings for infra/*.sh and data/load_bigquery.sh.
# Copy to infra/.env (git-ignored) and fill in. Never commit the real file.

PROJECT_ID=
# where Cloud Run, Cloud SQL, GCS and BigQuery live
REGION=asia-south1
# where Gemini is called from; backend/.env.example uses "global" because the
# Gemini 3.x Flash models are served from the global endpoint, not asia-south1
GOOGLE_CLOUD_LOCATION=global
# set from backend/.env.example (the backend owns the model id)
GEMINI_MODEL=
# globally unique, e.g. kirana-mitra-media-<project-id>
GCS_BUCKET=
CLOUDSQL_INSTANCE=kirana-pg
BQ_DATASET=kirana
# Cloud Run URL printed by infra/deploy.sh; the Flutter app reads it
API_BASE_URL=http://localhost:8080

# --- extras used by the scripts (keep defaults unless you know why) ---
CLOUD_RUN_SERVICE=kirana-mitra-api
CLOUD_RUN_SA=kirana-mitra-api
FORECAST_SOURCE=bigquery
AR_REPO=kirana-mitra
CLOUDSQL_DB=kirana
CLOUDSQL_USER=kirana
# required by setup.sh when it creates the Cloud SQL instance; also passed to
# Cloud Run as DB_PASSWORD by deploy.sh. Use Secret Manager for anything real.
CLOUDSQL_PASSWORD=
# passed through to the backend unchanged (see backend/.env.example)
GOOGLE_GENAI_USE_VERTEXAI=true
MOCK_GEMINI=0
CONFIRM_THRESHOLD=0.7
# optional: name of a gcloud configuration to use (sets CLOUDSDK_ACTIVE_CONFIG_NAME
# for the scripts only; the active configuration is never changed)
GCLOUD_CONFIG=
# public bucket for the Flutter web build (infra/deploy_web.sh); default <PROJECT_ID>-web
WEB_BUCKET=
# shared secret for the daily auto-restock call (Cloud Scheduler -> Cloud Run);
# generate with: openssl rand -hex 24   (never commit the real value)
SCHEDULER_TOKEN=
SCHEDULER_JOB=kirana-auto-restock
# backend persistence: firestore (default) uses the Native-mode database setup.sh creates
STORE=firestore
FIRESTORE_DATABASE=(default)
