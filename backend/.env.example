# Copy to backend/.env (git-ignored). Never commit real values.

# Use Vertex AI (ADC from `gcloud auth application-default login`), not the AI Studio API key path.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# "global" is the endpoint Gemini 3.x Flash is served from; asia-south1 is not listed for it.
GOOGLE_CLOUD_LOCATION=global

# Gemini 3.8 Flash: GA on Vertex AI (released 2026-09-02), audio input + structured output,
# available in the `global` location. Model id per
# https://docs.cloud.google.com/vertex-ai/generative-ai/docs/models/gemini/3-8-flash
# (checked 2026-10-18). Cheaper fallback with the same capabilities: gemini-3.5-flash
# https://docs.cloud.google.com/vertex-ai/generative-ai/docs/models/gemini/3-5-flash
GEMINI_MODEL=gemini-3.8-flash

# 1 = offline canned extractor (no credentials, no cost). 0 = live Gemini.
MOCK_GEMINI=0

# Below this confidence the entry is held for a "Haan, add karo" confirm tap.
CONFIRM_THRESHOLD=0.7
